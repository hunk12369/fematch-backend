# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Telegram Mini App Configuration
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_ExampleToken"

# Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fematch_db?schema=public"

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="fematch-photos"
R2_PUBLIC_DOMAIN="https://media.fematch.app"
